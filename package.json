{
  "name": "educare-lms",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm --filter @educare/database db:generate && turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "studio": "pnpm --filter @educare/database db:studio"
  },
  "devDependencies": {
    "next": "16.4.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": "16.4.2",
      "body-parser@1": "^1.20.6",
      "proxy-addr": "^2.0.8",
      "handlebars": "^4.7.10",
      "multer": "^2.3.0",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "@modelcontextprotocol/sdk": "^1.31.0"
    }
  },
  "packageManager": "pnpm@9.0.0"
}