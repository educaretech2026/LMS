generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  roleId      String
  role        Role         @relation(fields: [roleId], references: [id])
  userCentres UserCentre[]

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  uploadedMaterials   StudyMaterial[]
  assignmentsUploaded Assignment[]

  assignedEnquiries    Enquiry[]
  sentSmsLogs          SmsLog[]      @relation("SmsSender")
  recordedTransactions Transaction[] @relation("TransactionRecorder")
  recordedAttendances  Attendance[]  @relation("AttendanceRecorder")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., 'students.create'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Centre {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  address   String?
  contactNo String?
  email     String?
  status    CentreStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userCentres UserCentre[]
  batches     Batch[]
  liveClasses LiveClass[]
  exams       Exam[]
  Transaction Transaction[]

  @@map("centres")
}

enum CentreStatus {
  ACTIVE
  INACTIVE
}

model UserCentre {
  userId   String
  centreId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@id([userId, centreId])
  @@map("user_centres")
}

// -----------------------------------------------------------------------------
// CORE ACADEMIC HIERARCHY
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String    @id @default(uuid())
  name      String    @unique // e.g., "2025-26"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  batches   Batch[]
  exams     Exam[]
  materials StudyMaterial[]

  @@map("academic_years")
}

model Board {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "CBSE", "State"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches     Batch[]
  syllabi     Syllabus[]
  liveClasses LiveClass[]
  exams       Exam[]
  standards   Standard[]

  @@map("boards")
}

model Standard {
  id        String   @id @default(uuid())
  name      String // e.g., "Class 11", "Class 12"
  level     Int      @default(1)
  boardId   String?
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches     Batch[]
  syllabi     Syllabus[]
  liveClasses LiveClass[]
  exams       Exam[]

  @@unique([name, boardId])
  @@map("standards")
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "Physics", "Chemistry"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syllabi            Syllabus[]
  teacherAssignments TeacherAssignment[]
  studentAssignments Assignment[]
  exams              Exam[]

  enrollments        Enrollment[]
  attendances        Attendance[]

  @@map("subjects")
}

// -----------------------------------------------------------------------------
// CURRICULUM HIERARCHY
// -----------------------------------------------------------------------------

model Syllabus {
  id         String   @id @default(uuid())
  boardId    String
  standardId String
  subjectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  chapters  Chapter[]
  materials StudyMaterial[]

  @@unique([boardId, standardId, subjectId])
  @@map("syllabi")
}

model Chapter {
  id         String   @id @default(uuid())
  name       String
  syllabusId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topics   Topic[]

  exams         Exam[]
  materials     StudyMaterial[]
  batchProgress BatchChapterProgress[]
  assignments   Assignment[]

  @@map("chapters")
}

model Topic {
  id        String   @id @default(uuid())
  name      String
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  subtopics Subtopic[]

  exams           Exam[]
  materials       StudyMaterial[]
  batchProgress   BatchTopicProgress[]
  studentProgress StudentTopicProgress[]
  revisionTasks   TopicRevisionTask[]
  assignments     Assignment[]

  examImportance  String?
  difficulty      String?
  prevQnFrequency Int?

  @@map("topics")
}

model Subtopic {
  id        String   @id @default(uuid())
  name      String
  topicId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  exams       Exam[]
  materials   StudyMaterial[]
  assignments Assignment[]

  @@map("subtopics")
}

// -----------------------------------------------------------------------------
// ORGANIZATIONAL HIERARCHY (Batches)
// -----------------------------------------------------------------------------

model Batch {
  id             String    @id @default(uuid())
  name           String // e.g., "Division A", "Morning Batch"
  academicYearId String
  boardId        String
  standardId     String
  centreId       String
  trackId        String?
  track          TargetTrack? @relation(fields: [trackId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  board        Board        @relation(fields: [boardId], references: [id])
  standard     Standard     @relation(fields: [standardId], references: [id])
  centre       Centre       @relation(fields: [centreId], references: [id])

  enrollments          Enrollment[]
  assignments          TeacherAssignment[]
  exams                Exam[]
  homeworks            Assignment[]
  chapterProgress      BatchChapterProgress[]
  topicProgress        BatchTopicProgress[]
  studentTopicProgress StudentTopicProgress[]
  Attendance           Attendance[]

  @@map("batches")
}

// -----------------------------------------------------------------------------
// STUDENTS & ENROLLMENT
// -----------------------------------------------------------------------------

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  admissionNo String   @unique
  parentName  String?
  parentEmail String?
  parentPhone String?
  bloodGroup  String?
  dateOfBirth DateTime?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  feeRecords       FeeRecord[]
  submissions      AssignmentSubmission[]
  topicProgress    StudentTopicProgress[]
  revisionTasks    TopicRevisionTask[]
  AttendanceRecord AttendanceRecord[]
  examResults      ExamResult[]

  @@map("student_profiles")
}

model Enrollment {
  id               String    @id @default(uuid())
  studentProfileId String
  batchId          String
  trackId          String?
  track            TargetTrack? @relation(fields: [trackId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subjects       Subject[]

  @@unique([studentProfileId, batchId])
  @@map("enrollments")
}

// -----------------------------------------------------------------------------
// TEACHERS & ASSIGNMENTS
// -----------------------------------------------------------------------------

model TeacherProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  qualification String?
  experience    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@map("teacher_profiles")
}

model TeacherAssignment {
  id               String   @id @default(uuid())
  teacherProfileId String
  batchId          String
  subjectId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, batchId, subjectId])
  @@map("teacher_assignments")
}

// -----------------------------------------------------------------------------
// ACADEMIC CONTENT
// -----------------------------------------------------------------------------

model Exam {
  id             String   @id @default(uuid())
  title          String
  type           ExamType @default(QUESTION_BANK)
  academicYearId String
  batchId        String? // Made optional to support general class/board exams
  subjectId      String
  chapterId      String?
  topicId        String?
  subtopicId     String?

  boardId    String?
  standardId String?
  centreId   String?

  targetTrackId String?
  targetTrack   TargetTrack? @relation(fields: [targetTrackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  chapter      Chapter?     @relation(fields: [chapterId], references: [id])
  topic        Topic?       @relation(fields: [topicId], references: [id])
  subtopic     Subtopic?    @relation(fields: [subtopicId], references: [id])

  board    Board?    @relation(fields: [boardId], references: [id])
  standard Standard? @relation(fields: [standardId], references: [id])
  centre   Centre?   @relation(fields: [centreId], references: [id])

  mcqQuestions McqQuestion[]
  results      ExamResult[]

  @@map("exams")
}

model ExamResult {
  id             String         @id @default(uuid())
  examId         String
  studentId      String
  marksObtained  Float
  maxMarks       Float
  grade          String?
  remarks        String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentAnswers StudentAnswer[]

  @@unique([examId, studentId])
  @@map("exam_results")
}

enum ExamType {
  QUESTION_BANK
  MOCK_TEST
  MCQ_EXAM
}

model StudyMaterial {
  id             String       @id @default(uuid())
  title          String
  type           MaterialType // e.g., PDF, VIDEO, LINK
  url            String?
  thumbnailUrl   String?
  academicYearId String
  syllabusId     String
  chapterId      String?
  topicId        String?
  subtopicId     String?
  uploaderId     String?

  targetTrackId String?
  targetTrack   TargetTrack? @relation(fields: [targetTrackId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  syllabus     Syllabus     @relation(fields: [syllabusId], references: [id])
  chapter      Chapter?     @relation(fields: [chapterId], references: [id])
  topic        Topic?       @relation(fields: [topicId], references: [id])
  subtopic     Subtopic?    @relation(fields: [subtopicId], references: [id])
  uploader     User?        @relation(fields: [uploaderId], references: [id])

  @@map("study_materials")
}

enum MaterialType {
  PDF
  VIDEO
  LINK
  DOCUMENT
}

enum QuestionType {
  MCQ
  DESCRIPTIVE
}

model McqQuestion {
  id            String   @id @default(uuid())
  type          QuestionType @default(MCQ)
  questionText  String
  imageUrl      String?
  options       Json?
  correctOption String?
  explanation   String?
  marks         Float    @default(4)
  negativeMarks Float    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentAnswers StudentAnswer[]

  @@map("mcq_questions")
}

model StudentAnswer {
  id            String   @id @default(uuid())
  examResultId  String
  questionId    String
  
  selectedOption String? // For MCQs
  answerText     String? // For Descriptive text
  answerFileUrl  String? // For Descriptive file uploads

  marksAwarded  Float?   // Given by auto-grader or teacher
  isCorrect     Boolean?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examResult  ExamResult  @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  question    McqQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examResultId, questionId])
  @@map("student_answers")
}

// -----------------------------------------------------------------------------
// LIVE CLASSES
// -----------------------------------------------------------------------------

model LiveClass {
  id          String          @id @default(uuid())
  title       String
  subject     String
  teacherName String
  status      LiveClassStatus @default(SCHEDULED)
  scheduledAt DateTime
  duration    Int // in minutes
  roomId      String          @unique @default(uuid())

  boardId    String?
  standardId String?
  centreId   String?

  board    Board?    @relation(fields: [boardId], references: [id])
  standard Standard? @relation(fields: [standardId], references: [id])
  centre   Centre?   @relation(fields: [centreId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("live_classes")
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
}

model FeeRecord {
  id          String    @id @default(uuid())
  receiptNo   String    @unique
  studentId   String
  amount      Float
  date        DateTime  @default(now())
  status      FeeStatus @default(PENDING)
  paymentMode String?
  feeHead     String?

  student StudentProfile @relation(fields: [studentId], references: [id])

  targetTrackId String?
  targetTrack   TargetTrack? @relation(fields: [targetTrackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fee_records")
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

// -----------------------------------------------------------------------------
// ASSIGNMENTS
// -----------------------------------------------------------------------------

model Assignment {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  attachments Json? // Optional JSON containing array of { url: string, filename: string }

  batchId     String?
  subjectId   String?
  chapterId   String?
  topicId     String?
  subtopicId  String?
  uploaderId  String
  targetTrackId String?
  targetTrack   TargetTrack? @relation(fields: [targetTrackId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch    Batch?    @relation(fields: [batchId], references: [id])
  subject  Subject?  @relation(fields: [subjectId], references: [id])
  chapter  Chapter?  @relation(fields: [chapterId], references: [id])
  topic    Topic?    @relation(fields: [topicId], references: [id])
  subtopic Subtopic? @relation(fields: [subtopicId], references: [id])
  uploader User      @relation(fields: [uploaderId], references: [id])

  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  attachments  Json? // Optional JSON containing array of { url: string, filename: string }
  notes        String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Float?
  feedback     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}


// -----------------------------------------------------------------------------
// PROGRESS TRACKING
// -----------------------------------------------------------------------------

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model BatchChapterProgress {
  id          String         @id @default(uuid())
  batchId     String
  chapterId   String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([batchId, chapterId])
  @@map("batch_chapter_progress")
}

model BatchTopicProgress {
  id          String         @id @default(uuid())
  batchId     String
  topicId     String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([batchId, topicId])
  @@map("batch_topic_progress")
}

enum StudentTopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MASTERED
  REVISION_REQUIRED
}

enum RevisionStatus {
  UPCOMING
  DUE
  COMPLETED
  MISSED
}

model StudentTopicProgress {
  id        String @id @default(uuid())
  studentId String
  topicId   String
  batchId   String

  completionPercentage Float              @default(0)
  status               StudentTopicStatus @default(NOT_STARTED)

  lectureProgress  Float @default(0)
  materialProgress Float @default(0)
  practiceProgress Float @default(0)
  testProgress     Float @default(0)

  questionsAssigned  Int   @default(0)
  questionsAttempted Int   @default(0)
  questionsCorrect   Int   @default(0)
  questionsIncorrect Int   @default(0)
  practiceAccuracy   Float @default(0)

  testsAttempted   Int   @default(0)
  averageTestScore Float @default(0)
  latestTestScore  Float @default(0)

  lastActivityAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId, batchId])
  @@map("student_topic_progress")
}

model TopicRevisionTask {
  id             String         @id @default(uuid())
  studentId      String
  topicId        String
  revisionNumber Int
  scheduledDate  DateTime
  completedDate  DateTime?
  revisionScore  Float?
  status         RevisionStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_revision_tasks")
}

model SyllabusConfiguration {
  id String @id @default(uuid())

  // Weightages
  lectureWeight  Float @default(0.20)
  materialWeight Float @default(0.20)
  practiceWeight Float @default(0.30)
  testWeight     Float @default(0.30)

  // Completion Thresholds
  inProgressThreshold Float @default(25)
  completedThreshold  Float @default(75)

  // Mastery Rules
  masteryCompletionThreshold Float @default(90)
  masteryAccuracyThreshold   Float @default(80)
  masteryTestScoreThreshold  Float @default(80)
  masteryMinQuestions        Int   @default(20)

  // Revision Rules
  weakPracticeThreshold Float @default(60)
  weakTestThreshold     Float @default(60)
  revisionIntervalsDays Json  @default("[1, 3, 7, 14, 30]")

  updatedAt DateTime @updatedAt

  @@map("syllabus_configurations")
}

// -----------------------------------------------------------------------------
// ENQUIRY / LEADS (CRM)
// -----------------------------------------------------------------------------

model Enquiry {
  id            String  @id @default(uuid())
  studentName   String
  parentName    String?
  contactNumber String
  email         String?
  address       String?
  source        String? // e.g., Walk-in, Facebook, Reference

  targetBoard    String?
  targetStandard String?
  targetCourse   String?

  status       EnquiryStatus @default(NEW)
  followUpDate DateTime?
  notes        String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiries")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISITED
  QUALIFIED
  CONVERTED
  LOST
}

// -----------------------------------------------------------------------------
// SMS / COMMUNICATION
// -----------------------------------------------------------------------------

model SmsLog {
  id            String    @id @default(uuid())
  recipientName String
  phoneNumber   String
  message       String
  status        SmsStatus @default(PENDING)
  providerId    String? // e.g., Twilio message SID
  errorDetails  String?

  sentById String?
  sentBy   User?   @relation("SmsSender", fields: [sentById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_logs")
}

enum SmsStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// -----------------------------------------------------------------------------
// FINANCE (EXPENSE & INCOME)
// -----------------------------------------------------------------------------

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  category    String // e.g., Salary, Rent, Marketing, Event
  amount      Float
  date        DateTime        @default(now())
  reference   String? // e.g., Invoice No, Cheque No
  description String?
  paymentMode String? // Cash, UPI, Bank Transfer

  recordedById String
  recordedBy   User   @relation("TransactionRecorder", fields: [recordedById], references: [id])

  centreId String?
  centre   Centre? @relation(fields: [centreId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

// -----------------------------------------------------------------------------
// ATTENDANCE
// -----------------------------------------------------------------------------

model Attendance {
  id           String   @id @default(uuid())
  batchId      String?
  date         DateTime
  recordedById String
  subjectId    String?

  batch      Batch?   @relation(fields: [batchId], references: [id])
  subject    Subject? @relation(fields: [subjectId], references: [id])
  recordedBy User     @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, date, subjectId])
  @@map("attendances")
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus @default(PRESENT)
  remarks      String?

  attendance Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceId, studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model TargetTrack {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches       Batch[]
  enrollments   Enrollment[]
  exams         Exam[]
  studyMaterials StudyMaterial[]
  feeRecords    FeeRecord[]
  assignments   Assignment[]

  @@map("target_tracks")
}

// -----------------------------------------------------------------------------
// COURSE LMS (PUBLIC & PAYMENTS)
// -----------------------------------------------------------------------------

model PublicUser {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  googleId      String?  @unique
  name          String
  avatar        String?
  passwordHash  String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  otps          OtpToken[]
  enrollments   CourseEnrollment[]
  payments      Payment[]
  subscriptions UserSubscription[]

  @@map("public_users")
}

model OtpToken {
  id          String   @id @default(uuid())
  userId      String
  otp         String
  expiresAt   DateTime
  used        Boolean  @default(false)
  
  user        PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
  LIVE
}

model Course {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  description      String
  thumbnail        String?
  price            Decimal
  currency         String   @default("INR")
  isFree           Boolean  @default(false)
  isPublished      Boolean  @default(false)
  duration         Int?     // in hours
  level            CourseLevel
  createdByAdminId String?
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modules          CourseModule[]
  enrollments      CourseEnrollment[]
  payments         Payment[]
  
  subscriptionAccess SubscriptionCourseAccess[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("course_modules")
}

model Lesson {
  id         String      @id @default(uuid())
  moduleId   String
  title      String
  type       LessonType
  content    String?     // URL or video ID
  duration   Int?        // seconds
  order      Int
  isFree     Boolean     @default(false)
  
  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]

  @@map("lessons")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  courseId         String?
  amount           Decimal
  currency         String
  status           PaymentStatus
  gateway          String
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  refundedAt       DateTime?
  refundReason     String?
  refundedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             PublicUser @relation(fields: [userId], references: [id])
  course           Course?    @relation(fields: [courseId], references: [id])
  enrollment       CourseEnrollment?
  subscription     UserSubscription?

  @@map("payments")
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  paymentId   String?  @unique
  enrolledAt  DateTime @default(now())
  expiresAt   DateTime?
  completedAt DateTime?

  user        PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment     Payment?   @relation(fields: [paymentId], references: [id])
  progress    LessonProgress[]

  @@map("course_enrollments")
}

model LessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  lessonId     String
  completed    Boolean  @default(false)
  watchedSecs  Int      @default(0)
  completedAt  DateTime?

  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  price         Decimal
  currency      String   @default("INR")
  intervalDays  Int
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())

  subscriptions UserSubscription[]
  courseAccess  SubscriptionCourseAccess[]

  @@map("subscription_plans")
}

model SubscriptionCourseAccess {
  planId   String
  courseId String
  
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@id([planId, courseId])
  @@map("subscription_course_access")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model UserSubscription {
  id         String   @id @default(uuid())
  userId     String
  planId     String
  paymentId  String?  @unique
  startDate  DateTime
  endDate    DateTime
  status     SubscriptionStatus
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       PublicUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payment    Payment?         @relation(fields: [paymentId], references: [id])

  @@map("user_subscriptions")
}
