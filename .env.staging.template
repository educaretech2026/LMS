# =============================================================================
# EDUCARE LMS — STAGING ENVIRONMENT TEMPLATE (.env.staging.template)
# Placeholders Only — Zero Real Secrets — Safe for Version Control
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Runtime Mode & Deployment Tier
# NODE_ENV=production enforces bundler optimizations and performance profiles.
# APP_ENV=staging designates the isolated staging infrastructure tier.
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=staging
PORT=3001

# -----------------------------------------------------------------------------
# 2. Database Configuration (Isolated Staging PostgreSQL 14+)
# Preflight rules enforced by database-target.validator & safe-migrate-deploy:
# - MUST NOT match production IP (148.135.138.196) or production hostnames.
# - MUST enforce sslmode=require for all remote / cloud-hosted endpoints.
# - MUST be listed in STAGING_DATABASE_ALLOWLIST if using a remote hostname.
# -----------------------------------------------------------------------------
STAGING_DATABASE_ALLOWLIST="staging-db.educare.internal,staging-postgres,staging-db"
DATABASE_URL="postgresql://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_DB_HOST>:5432/<STAGING_DB_NAME>?schema=public&sslmode=require"
DIRECT_URL="postgresql://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_DB_HOST>:5432/<STAGING_DB_NAME>?schema=public&sslmode=require"

# -----------------------------------------------------------------------------
# 3. Redis Configuration (Dedicated Staging Redis 7+)
# Mandatory in staging for distributed rate limiting and token revocation.
# Must NOT use unauthenticated or default credentials.
# -----------------------------------------------------------------------------
REDIS_URL="redis://:<STAGING_REDIS_PASSWORD>@<STAGING_REDIS_HOST>:6379"

# -----------------------------------------------------------------------------
# 4. Authentication Secrets
# Minimum 32-character high-entropy secret. Generate via: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET="<STAGING_HIGH_ENTROPY_JWT_SECRET_MIN_32_CHARS>"

# -----------------------------------------------------------------------------
# 5. Cloudflare Turnstile (Staging Domain Scoped)
# Dedicated staging widget keys provisioned for staging domains.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY="<STAGING_TURNSTILE_SECRET_KEY>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="<STAGING_TURNSTILE_SITE_KEY>"
TURNSTILE_ALLOWED_HOSTNAMES="staging.educarelearning.in,lms.staging.educarelearning.in"

# -----------------------------------------------------------------------------
# 6. Cloudflare R2 Object Storage & Stream (Dedicated Staging Bucket)
# Must NOT point to production bucket ('educare').
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="<STAGING_CLOUDFLARE_ACCOUNT_ID>"
CLOUDFLARE_STREAM_API_TOKEN="<STAGING_STREAM_API_TOKEN>"
CLOUDFLARE_R2_ACCESS_KEY_ID="<STAGING_R2_ACCESS_KEY_ID>"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="<STAGING_R2_SECRET_ACCESS_KEY>"
CLOUDFLARE_R2_BUCKET_NAME="educare-staging"
CLOUDFLARE_R2_PUBLIC_DOMAIN="staging-media.educarelearning.in"

# -----------------------------------------------------------------------------
# 7. LiveKit WebRTC Video Infrastructure (Dedicated Staging Project)
# Must NOT point to production LiveKit project or rooms.
# -----------------------------------------------------------------------------
LIVEKIT_WS_URL="wss://educarelms-staging.livekit.cloud"
LIVEKIT_API_KEY="<STAGING_LIVEKIT_API_KEY>"
LIVEKIT_API_SECRET="<STAGING_LIVEKIT_API_SECRET>"

# -----------------------------------------------------------------------------
# 8. Networking, Ingress & Security Headers
# TRUSTED_PROXIES must be restricted strictly to the ingress controller VPC CIDR.
# -----------------------------------------------------------------------------
TRUSTED_PROXIES="10.0.1.0/24"
CORS_ORIGINS="https://staging.educarelearning.in,https://lms.staging.educarelearning.in"

# -----------------------------------------------------------------------------
# 9. Frontend BFF Upstream & Client API Bindings
# -----------------------------------------------------------------------------
INTERNAL_API_URL="https://staging-api.educarelearning.in/api"
NEXT_PUBLIC_API_URL="https://staging-api.educarelearning.in/api"
EXPO_PUBLIC_API_URL="https://staging-api.educarelearning.in/api"
