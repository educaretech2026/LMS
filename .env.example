
# Authentication & Security
# Required in production: must be a strong random secret with at least 32 characters
# Generate one using: openssl rand -base64 32
JWT_SECRET=

# Database & Cache
DATABASE_URL="postgresql://educare:password@localhost:5433/educare_db?schema=public"
REDIS_URL="redis://localhost:6379"

# WhatsApp Meta API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare Turnstile Bot Protection (Set DISABLE_TURNSTILE=true to disable)
DISABLE_TURNSTILE="true"
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
